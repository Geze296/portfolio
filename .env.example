# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://gezahegngulilat.vercel.app

# Contact form — Resend (https://resend.com). Server-side only; never exposed to the browser.
RESEND_API_KEY=
# Where messages are delivered (defaults to the email in src/content/site.ts)
CONTACT_TO_EMAIL=gezahegngulilat1@gmail.com
# Verified sender. Until you verify a domain in Resend, use onboarding@resend.dev
# (that sender can only deliver to the email address of your Resend account).
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
